# Copy to .env and fill in. Never commit .env.
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://iwcd-shifts.hyperk.ca
ALLOWED_HOSTS=iwcd-shifts.hyperk.ca

# SQLite by default (file lives in ./data). Postgres also works:
# DATABASE_URL=postgres://user:pass@host:5432/iwcd_shifts
DATABASE_URL=sqlite:////srv/iwcd-shifts/data/db.sqlite3
BACKUP_DIR=/srv/iwcd-shifts/backups

# Outgoing mail (ask whoever runs wcte.hyperk.ca which relay it uses)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IWCD Shifts <no-reply@hyperk.ca>
# Comma-separated; gets "withdrawn from assignment" alerts. Defaults to all staff users.
COORDINATOR_EMAILS=

# Hyper-K SSO (HKDB IdP at IN2P3)
SAML_ENABLED=True
SAML_DIR=/srv/iwcd-shifts/saml
SAML_IDP_METADATA_URL=https://hkdbweb.in2p3.fr/saml20-metadata.xml
XMLSEC_BINARY=/usr/bin/xmlsec1
# Set once Cristiano confirms what the IdP signs:
SAML_WANT_RESPONSE_SIGNED=False
SAML_WANT_ASSERTIONS_SIGNED=True
SAML_CONTACT_NAME=
SAML_CONTACT_EMAIL=

# Email-link login (fallback). Only works for addresses already in the tool.
MAGIC_LINK_ENABLED=True
